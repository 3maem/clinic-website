# قاعدة البيانات والصور المرفوعة — نسخ احتياطي محلي، ليست كودًا
site/wp-content/database/
site/wp-content/uploads/

*.log

# حزم الرفع الجاهزة — تُبنى من المصدر المتتبَّع عبر build/make-zips.php
# لكن حزم النشر نفسها متتبَّعة حتى يمكن جلبها مباشرة على الخادم من GitHub.
dist/*
!dist/clinic-content.xml
!dist/clinic-custom.zip
!dist/clinic-server-setup.zip
!dist/clinic-uploads.zip

# النسخة المحلية على MySQL — تُبنى من site/ ولا تُرفع للريبو
site-mysql/
router-mysql.php

# مخرجات النشر الكامل: تحتوي تجزئة كلمة مرور admin وحجمها كبير — تبقى محلية
dist/clinic-db.sql
dist/clinic-db-compat.sql
dist/clinic-wp-content.zip

