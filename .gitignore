# أدوات محلية — تُنزَّل عند الإعداد ولا تُرفع للريبو
tools/php/
tools/wp-cli/
tools/*.zip

# نواة ووردبريس والإضافات والقوالب الخارجية — تُثبَّت عبر WP-CLI
